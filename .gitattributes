# -------------------------
# LINE ENDINGS (khuyến nghị cho Android/Java)
# Mặc định: chuẩn hoá text về LF trong repo và checkout ra LF trên mọi OS.
# -------------------------
* text=auto eol=lf

# --------
# TEXT FILES
# --------
*.java        text eol=lf
*.kt          text eol=lf
*.xml         text eol=lf
*.gradle      text eol=lf
gradle.properties text eol=lf
local.properties  text eol=lf
*.properties  text eol=lf
*.pro         text eol=lf
proguard-rules.pro text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.csv         text eol=lf
*.json        text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.ini         text eol=lf
*.cfg         text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.js          text eol=lf
*.ts          text eol=lf
*.svg         text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore    text eol=lf

# -------------
# SCRIPTS
# -------------
# Shell scripts dùng LF
*.sh          text eol=lf
*.bash        text eol=lf
gradlew       text eol=lf

# Script Windows dùng CRLF
*.bat         text eol=crlf
*.cmd         text eol=crlf
*.ps1         text eol=crlf
gradlew.bat   text eol=crlf

# -------------
# BINARY/ASSETS (không đổi line endings)
# -------------
