<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="2dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_compare_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivSummaryIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="4dp"
            android:visibility="gone"
        tools:src="@drawable/ic_trend_up"
        tools:tint="#FF0000"
        tools:visibility="visible"/>

        <TextView
            android:id="@+id/tvSummaryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sub_text_color"
            android:textSize="14sp"
            tools:text="Cao nhất" />
    </LinearLayout>

        <TextView
            android:id="@+id/tvSummaryTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#3F51B5"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="32°" />

        <TextView
            android:id="@+id/tvSummaryCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sub_text_color"
            android:textSize="14sp"
            tools:text="Hồ Chí Minh" />
    </LinearLayout>

</androidx.cardview.widget.CardView>