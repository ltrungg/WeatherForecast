<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/about_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FAFF">

    <!-- Thanh back dễ bấm (56dp) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_right_24"
            android:scaleX="-1"
            android:contentDescription="@string/app_name"/>

        <TextView
            android:id="@+id/tvBackLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quay lại"
            android:textColor="#5E6C84"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollAbout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_cloud_24"
                    app:tint="#6C8EE6"
                    android:contentDescription="@string/app_name"/>

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weather Forecast"
                    android:textStyle="bold"
                    android:textSize="24sp"
                    android:textColor="#1B2B41"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phiên bản 1.0.0"
                    android:textColor="#6C84A3"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Giới thiệu -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giới thiệu"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#1B2B41"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Weather Forecast là ứng dụng dự báo thời tiết hiện đại, cung cấp thông tin chi tiết cho vị trí của bạn với giao diện gọn gàng, dễ đọc. Ứng dụng hiển thị thời tiết hiện tại và dự báo 7 ngày, kèm các chỉ số quan trọng."
                        android:textColor="#5E6C84"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tính năng nổi bật -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tính năng nổi bật"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#1B2B41"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Thời tiết hiện tại với: nhiệt độ, độ ẩm, gió, tầm nhìn, lượng mưa, mô tả trạng thái\n• Dự báo 7 ngày với nhiệt độ cao/thấp, bình minh/hoàng hôn, khả năng mưa\n• Chọn đơn vị nhiệt độ (°C/°F) và tốc độ gió (km/h, mph)\n• Lưu vị trí hiện tại hoặc dùng vị trí tự động\n• Giao diện Material, thẻ thông tin rõ ràng, hỗ trợ màn hình nhỏ"
                        android:textColor="#5E6C84"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nguồn dữ liệu -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nguồn dữ liệu"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#1B2B41"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dữ liệu được cung cấp bởi Open-Meteo (open-meteo.com). Các chỉ số được xử lý qua Retrofit/OkHttp và lưu cục bộ bằng Room để hiển thị mượt mà và dùng được khi ngoại tuyến (khi còn dữ liệu gần nhất)."
                        android:textColor="#5E6C84"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
