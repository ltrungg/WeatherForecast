<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FAFF"
    tools:context=".MainActivity">

    <!-- Cuộn toàn bộ nội dung -->
    <ScrollView
        android:id="@+id/scrollMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutMainWeather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="60dp"
            android:background="#F6FAFF">

            <!-- ========== SECTION 1: Thông tin thời tiết chính ========== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Thành phố -->
                <TextView
                    android:id="@+id/tvCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_location_24"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:text="Hà Nội"
                    android:textColor="#172B4D"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Ngày tháng -->
                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Thứ 5, 16 tháng 10 2025"
                    android:textColor="#7A869A"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Thẻ thời tiết chính -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMainWeather"
                android:layout_width="match_parent"
                android:layout_height="255dp"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="20dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="5dp"
                app:cardUseCompatPadding="true"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="12dp">

                    <!-- Icon thời tiết -->
                    <ImageView
                        android:id="@+id/imgWeatherIcon"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@drawable/ic_cloud_24"
                        app:tint="#77A8E8"
                        android:layout_marginBottom="8dp" />

                    <!-- Nhiệt độ -->
                    <TextView
                        android:id="@+id/tvTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28°"
                        android:textColor="#77A8E8"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <!-- Mô tả -->
                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nhiều mây"
                        android:textColor="#5E6C84"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginTop="2dp" />

                    <!-- Cao / thấp -->
                    <TextView
                        android:id="@+id/tvMinMax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Cao: 32° · Thấp: 24°"
                        android:textColor="#7A869A"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- ========== SECTION 2: Thông tin chi tiết ========== -->
            <LinearLayout
                android:id="@+id/layoutWeatherDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="12dp"
                android:gravity="center">

                <!-- ========== SECTION 2: Gió, Độ ẩm, Tầm nhìn, Áp suất ========== -->
                <LinearLayout
                    android:id="@+id/layoutWeatherInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="2dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center">

                    <!-- Hàng 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- Gió -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="3dp"
                            android:backgroundTint="#FFFFFF"
                            android:layout_margin="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvWindLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableStart="@drawable/ic_wind"
                                    android:drawablePadding="6dp"
                                    android:text="Gió"
                                    android:textColor="#7A869A"
                                    android:textSize="16sp"
                                    />

                                <TextView
                                    android:id="@+id/tvWindValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12 km/h"
                                    android:textStyle="bold"
                                    android:textSize="22sp"
                                    android:textColor="#172B4D"
                                    android:layout_marginTop="7dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Độ ẩm -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="3dp"
                            android:backgroundTint="#FFFFFF"
                            android:layout_margin="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvHumidityLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableStart="@drawable/ic_humidity"
                                    android:drawablePadding="6dp"
                                    android:text="Độ ẩm"
                                    android:textSize="16sp"
                                    android:textColor="#7A869A" />

                                <TextView
                                    android:id="@+id/tvHumidityValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="75%"
                                    android:textStyle="bold"
                                    android:textSize="22sp"
                                    android:textColor="#172B4D"
                                    android:layout_marginTop="7dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Hàng 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- Tầm nhìn -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="3dp"
                            android:backgroundTint="#FFFFFF"
                            android:layout_margin="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvVisibilityLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableStart="@drawable/ic_vision"
                                    android:drawablePadding="6dp"
                                    android:text="Tầm nhìn"
                                    android:textSize="16sp"
                                    android:textColor="#7A869A" />

                                <TextView
                                    android:id="@+id/tvVisibilityValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="10 km"
                                    android:textStyle="bold"
                                    android:textSize="22sp"
                                    android:textColor="#172B4D"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Áp suất -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="3dp"
                            android:backgroundTint="#FFFFFF"
                            android:layout_margin="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvPressureLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableStart="@drawable/ic_pressure"
                                    android:drawablePadding="6dp"
                                    android:text="Áp suất"
                                    android:textSize="16sp"
                                    android:textColor="#7A869A" />

                                <TextView
                                    android:id="@+id/tvPressureValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1013 mb"
                                    android:textStyle="bold"
                                    android:textSize="22sp"
                                    android:textColor="#172B4D"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>


                <!-- Hàng 2: Bình minh & Hoàng hôn -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSunInfo"
                    android:layout_width="340dp"
                    android:layout_height="115dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    android:backgroundTint="#FFFFFF">

                    <LinearLayout
                        android:layout_width="345dp"
                        android:layout_height="110dp"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center">

                        <!-- Bình minh -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_sunrise"
                                app:tint="#FFD966" />

                            <TextView
                                android:id="@+id/tvSunriseLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bình minh"
                                android:textColor="#7A869A"
                                android:textSize="13sp"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvSunriseTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="05:45"
                                android:textColor="#172B4D"
                                android:textStyle="bold"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Hoàng hôn -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_sunset"
                                app:tint="#FFD966" />

                            <TextView
                                android:id="@+id/tvSunsetLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hoàng hôn"
                                android:textColor="#7A869A"
                                android:textSize="13sp"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvSunsetTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="17:32"
                                android:textColor="#172B4D"
                                android:textStyle="bold"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>


        </LinearLayout>
    </ScrollView>
    <!-- ========== SECTION 3: Thanh menu dưới (Bottom Navigation) ========== -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav"
        app:labelVisibilityMode="labeled"
        app:itemRippleColor="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
