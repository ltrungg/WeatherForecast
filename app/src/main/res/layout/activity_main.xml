<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FAFF"
    tools:context=".MainActivity">

    <!-- Sửa lỗi: Căn chỉnh BottomNavigationView xuống dưới cùng -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />

    <!-- Sửa lỗi: Cho ScrollView chiếm toàn bộ không gian phía trên BottomNavigationView -->
    <ScrollView
        android:id="@+id/scrollMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <!-- Nội dung bên trong ScrollView được giữ nguyên -->
        <LinearLayout
            android:id="@+id/layoutMainWeather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sky"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="60dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_location_24"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:text="Hà Nội"
                    android:textColor="#172B4D"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Thứ 5, 16 tháng 10 2025"
                    android:textColor="#7A869A"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Card chính -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMainWeather"
                android:layout_width="match_parent"
                android:layout_height="255dp"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="20dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="5dp"
                app:cardUseCompatPadding="true"
                android:backgroundTint="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="12dp">

                    <ImageView
                        android:id="@+id/imgWeatherIcon"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:src="@drawable/ic_cloud_24"
                        app:tint="#77A8E8"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@string/app_name" />

                    <TextView
                        android:id="@+id/tvTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28°"
                        android:textColor="#77A8E8"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nhiều mây"
                        android:textColor="#5E6C84"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvMinMax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Cao: 32° · Thấp: 24°"
                        android:textColor="#7A869A"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Chi tiết -->
            <LinearLayout
                android:id="@+id/layoutWeatherDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="12dp"
                android:gravity="center">

                <LinearLayout
                    android:id="@+id/layoutWeatherInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="2dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center">

                    <!-- Hàng 1: Gió / Độ ẩm -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="3dp"
                            android:backgroundTint="#FFFFFF"
                            android:layout_margin="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvWindLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableStart="@drawable/ic_wind"
                                    android:drawablePadding="6dp"
                                    android:text="Gió"
                                    android:textColor="#7A869A"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/tvWindValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12 km/h"
                                    android:textStyle="bold"
                                    android:textSize="22sp"
                                    android:textColor="#172B4D"
                                    android:layout_marginTop="7dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="3dp"
                            android:backgroundTint="#FFFFFF"
                            android:layout_margin="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvHumidityLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableStart="@drawable/ic_humidity"
                                    android:drawablePadding="6dp"
                                    android:text="Độ ẩm"
                                    android:textSize="16sp"
                                    android:textColor="#7A869A" />

                                <TextView
                                    android:id="@+id/tvHumidityValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="75%"
                                    android:textStyle="bold"
                                    android:textSize="22sp"
                                    android:textColor="#172B4D"
                                    android:layout_marginTop="7dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Hàng 2: Tầm nhìn / Lượng mưa -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="3dp"
                            android:backgroundTint="#FFFFFF"
                            android:layout_margin="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvVisibilityLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableStart="@drawable/ic_vision"
                                    android:drawablePadding="6dp"
                                    android:text="Tầm nhìn"
                                    android:textSize="16sp"
                                    android:textColor="#7A869A" />

                                <TextView
                                    android:id="@+id/tvVisibilityValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="10 km"
                                    android:textStyle="bold"
                                    android:textSize="22sp"
                                    android:textColor="#172B4D"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- ĐỔI NHÃN: Áp suất -> Lượng mưa -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="90dp"
                            android:layout_weight="1"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="3dp"
                            android:backgroundTint="#FFFFFF"
                            android:layout_margin="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvPressureLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableStart="@drawable/ic_pressure"
                                    android:drawablePadding="6dp"
                                    android:text="Lượng mưa"
                                    android:textSize="16sp"
                                    android:textColor="#7A869A" />

                                <TextView
                                    android:id="@+id/tvPressureValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 mm"
                                    android:textStyle="bold"
                                    android:textSize="22sp"
                                    android:textColor="#172B4D"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>

                <!-- Bình minh & Hoàng hôn -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSunInfo"
                    android:layout_width="340dp"
                    android:layout_height="115dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginHorizontal="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    android:backgroundTint="#FFFFFF">

                    <LinearLayout
                        android:layout_width="345dp"
                        android:layout_height="110dp"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_sunrise"
                                app:tint="#FFD966"
                                android:contentDescription="@string/app_name" />

                            <TextView
                                android:id="@+id/tvSunriseLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bình minh"
                                android:textColor="#7A869A"
                                android:textSize="13sp"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvSunriseTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="05:45"
                                android:textColor="#172B4D"
                                android:textStyle="bold"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_sunset"
                                app:tint="#FFD966"
                                android:contentDescription="@string/app_name" />

                            <TextView
                                android:id="@+id/tvSunsetLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hoàng hôn"
                                android:textColor="#7A869A"
                                android:textSize="13sp"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvSunsetTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="17:32"
                                android:textColor="#172B4D"
                                android:textStyle="bold"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Giữ nguyên vị trí của FAB, căn chỉnh so với BottomNavigationView -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNavigation"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="AI Chatbot"
        android:src="@drawable/ic_chat_bubble"
        app:tint="@android:color/white" />

</RelativeLayout>